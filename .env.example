# Server only. Never expose this value through VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_REQUEST_INTERVAL_MS=7000
# Attempts per Gemini call. Only 429 and 5xx are retried; 4xx fails immediately.
GEMINI_MAX_ATTEMPTS=6
SPECTRA_API_PORT=8787
SPECTRA_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Audits that may stream at once before the API answers 503.
SPECTRA_MAX_CONCURRENT_AUDITS=3
SPECTRA_CRAWLER_BIN=services/crawler/target/release/spectra-crawler
SPECTRA_DATA_DIR=.spectra/audits
